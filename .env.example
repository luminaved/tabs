# Скопируйте нужные строки: DATABASE_URL — в .env (его читает Prisma CLI),
# AUTH_SECRET — в .env.local. Оба файла в .gitignore.

# ─── База данных ────────────────────────────────────────────────────────────
# Проект работает на PostgreSQL (provider в prisma/schema.prisma — "postgresql").
# Подойдёт и локальный Postgres, и Neon. Для Neon берите pooled-строку: хост с
# "-pooler", обязателен sslmode=require.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# После первого подключения подготовьте поиск (расширение pg_trgm + индекс):
#   node scripts/setup-search.mjs

# ─── Адрес сайта ────────────────────────────────────────────────────────────
# Нужен для canonical-ссылок, sitemap.xml, feed.xml и картинок превью в
# мессенджерах. На Vercel определяется автоматически; локально можно не задавать.
# NEXT_PUBLIC_SITE_URL="https://ваш-домен.ru"

# ─── Панели вебмастера (необязательно) ──────────────────────────────────────
# Коды подтверждения прав на сайт. Выводятся тегом <meta> в <head>; пустые
# переменные тег не создают. У Google права уже подтверждены файлом в public/ —
# переменная ниже нужна, только если файл потеряется. Яндекс для русскоязычного
# сайта стоит подключить отдельно: https://webmaster.yandex.ru
# Значение — только сам код из тега, без <meta ... content="…">.
# GOOGLE_SITE_VERIFICATION="...."
# YANDEX_VERIFICATION="...."

# ─── Auth.js ────────────────────────────────────────────────────────────────
# Секрет для подписи JWT-сессий. Сгенерировать:  npx auth secret
AUTH_SECRET="replace-with-generated-secret"

# ─── Общий счётчик попыток входа (необязательно, но нужно в проде) ───────────
# Лимит попыток входа и регистрации по умолчанию живёт в памяти процесса. На
# одной машине этого достаточно, а на Vercel инстансов несколько, и потолок
# молча умножается на их число. С этими переменными счётчик уезжает в общее
# хранилище (Upstash Redis по REST — отдельный пакет не нужен).
# Создать базу: https://console.upstash.com  →  вкладка REST API.
# Если хранилище не отвечает, вход НЕ ломается: попытки досчитываются в памяти.
# UPSTASH_REDIS_REST_URL="https://....upstash.io"
# UPSTASH_REDIS_REST_TOKEN="...."

# ─── Счётчик просмотров (необязательно) ──────────────────────────────────────
# Соль для отпечатка гостя (IP + User-Agent хешируются, сам адрес никуда не
# пишется). Без неё берётся AUTH_SECRET — работает, но отдельный ключ чище:
# его можно менять, не разлогинивая всех.  Сгенерировать:  npx auth secret
# VIEW_SALT="....."

# ─── Google-вход (необязательно) ─────────────────────────────────────────────
# Кнопка «Продолжить с Google» появляется, только если заданы обе переменные.
# Создать OAuth-креды: https://console.cloud.google.com/apis/credentials
#   тип «Web application», Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google   (+ ваш прод-URL)
# AUTH_GOOGLE_ID="....apps.googleusercontent.com"
# AUTH_GOOGLE_SECRET="...."

# ─── Вход через Яндекс (необязательно) ───────────────────────────────────────
# Приложение создаётся на https://oauth.yandex.ru/client/new — одна форма,
# без экрана согласия и без модерации (в отличие от Google).
#
# Что выбрать в форме:
#   Платформа           — «Веб-сервисы»
#   Redirect URI        — http://localhost:3000/api/auth/callback/yandex
#                         и https://ВАШ-ДОМЕН/api/auth/callback/yandex
#                         (адреса добавляются оба, совпадение посимвольное)
#   Доступ к данным     — «Логин, имя и фамилия, пол», «Адрес электронной
#                         почты», «Портрет пользователя»
#                         (login:info, login:email, login:avatar)
#
# ВАЖНО: доступ к почте обязателен. Без адреса аккаунт не создать — он в схеме
# обязательный, — и такой вход будет отклонён с объяснением.
#
# После создания скопируйте «ID» и «Пароль» приложения (это и есть client
# secret) и перезапустите сервер: переменные читаются при старте.
# AUTH_YANDEX_ID="...."
# AUTH_YANDEX_SECRET="...."

# ─── Вход через Telegram (необязательно) ─────────────────────────────────────
# Здесь не OAuth, а виджет с подписью, поэтому переменные другие.
#
# 1. В @BotFather:  /newbot  → получите ТОКЕН вида 123456:AA...
# 2. Там же:        /setdomain  → выберите бота и укажите домен САЙТА
#                   (без https:// и без пути). Домен должен совпадать с тем,
#                   где открыта страница входа, иначе кнопка не появится.
# 3. Имя бота — то, что после @, без собачки.
#
# ВАЖНО про localhost: Telegram не принимает его как домен, поэтому локально
# кнопка не появится. Проверять вход придётся на боевом домене (или через
# туннель вроде ngrok, указав его домен в /setdomain).
#
# Кнопка показывается, только если заданы ОБЕ переменные. Если задана ровно
# одна, сервер напишет об этом в лог при старте — молча прятать кнопку в таком
# случае значило бы прятать и опечатку.
#
# Обе переменные — СЕРВЕРНЫЕ, без префикса NEXT_PUBLIC_: тот заставляет Next
# подставлять значение при сборке, и переменная, заведённая уже после неё, не
# подхватывалась бы до следующей пересборки.
# TELEGRAM_BOT_TOKEN="123456:AA...."
# TELEGRAM_BOT_NAME="rawchords_bot"
