// Prisma-схема. Локально — SQLite (файл, без внешних сервисов), чтобы всё
// работало сразу. Схема переносима на PostgreSQL/Neon: без enum'ов и
// провайдер-специфичных типов — для деплоя поменяйте provider на "postgresql"
// и DATABASE_URL на строку Neon (см. README).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth.js (стандартные модели) ──────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Хеш пароля (bcrypt). Расширение поверх стандартной схемы Auth.js
  // для входа по email+паролю. Опционален: magic-link не требует пароля.
  passwordHash  String?
  createdAt     DateTime  @default(now())

  accounts  Account[]
  sessions  Session[]
  songs     Song[]
  setlists  Setlist[]
  likes     Like[]
  favorites Favorite[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Модели приложения ─────────────────────────────────────────────────────

model Song {
  id         String   @id @default(cuid())
  title      String
  artist     String?
  key        String? // тональность, напр. "Am", "Bb"
  capo       Int      @default(0)
  tempo      Int?
  body       String // текст в формате ChordPro, хранится как есть
  note       String? // заметка от автора, показывается над текстом (видна всем)
  coverUrl   String? // обложка: data URL (загружается и сжимается на клиенте)
  chordDefs  String? // JSON: кастомные аппликатуры { "имя": [лады по струнам] }
  // "private" | "unlisted" | "public" (по умолчанию — приватная)
  visibility String   @default("private")
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  annotations  Annotation[]
  setlistItems SetlistItem[]
  likes        Like[]
  favorites    Favorite[]

  @@index([userId])
  @@index([visibility])
}

model Annotation {
  id     String @id @default(cuid())
  songId String
  // Якорь: номер строки ("12") — совместим с номерами строк из парсера.
  anchor String
  text   String
  // "technique" | "rhythm" | "transition" | "note" (техника/ритм/переход/заметка)
  type      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId])
}

model Setlist {
  id        String   @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items SetlistItem[]

  @@index([userId])
}

// Упорядоченная связь many-to-many между сетлистом и песнями.
model SetlistItem {
  id        String @id @default(cuid())
  setlistId String
  songId    String
  order     Int

  setlist Setlist @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  song    Song    @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([setlistId, songId])
  @@index([setlistId])
}

// Лайк пользователя на разбор (один на пару пользователь+песня).
model Like {
  id        String   @id @default(cuid())
  userId    String
  songId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
  @@index([songId])
}

// Избранное пользователя (просмотр — позже, в личном кабинете).
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  songId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
  @@index([songId])
}
